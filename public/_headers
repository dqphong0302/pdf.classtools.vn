# Cloudflare static-asset headers (the site is served straight from assets, no Worker code).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  # The Scan tool needs the camera on this origin.
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

# Content-hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# WASM engines are large (Ghostscript ~15 MB) but only change with dependency upgrades.
/wasm/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=604800
